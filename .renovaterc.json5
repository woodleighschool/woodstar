{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["local>woodleighschool/renovate-config"],
  postUpdateOptions: ["gomodTidy", "gomodUpdateImportPaths", "pnpmDedupe"],
  packageRules: [
    {
      // Fetching AWS SDK changelogs cause some major renovate constipation.
      matchSourceUrls: ["https://github.com/aws/aws-sdk-go-v2{/**,}"],
      fetchChangeLogs: "off",
    },
    {
      matchManagers: ["npm", "mise"],
      minimumReleaseAge: "12 hours",
    },
    {
      description: "Go Toolchain Group",
      matchManagers: ["dockerfile", "gomod", "mise"],
      matchDepNames: ["go", "golang"],
      matchFileNames: ["Dockerfile", "go.mod", ".mise/config.toml"],
      minimumGroupSize: 2,
    },
    {
      description: "Node Toolchain Group",
      matchManagers: ["dockerfile", "mise"],
      matchDepNames: ["node"],
      matchFileNames: ["Dockerfile", ".mise/config.toml"],
      minimumGroupSize: 2,
    },
    {
      description: "pnpm Group",
      matchManagers: ["mise", "npm"],
      matchDepNames: ["pnpm"],
      matchFileNames: [".mise/config.toml", "docs/package.json", "web/package.json"],
      minimumGroupSize: 3,
    },
    {
      matchManagers: ["gomod"],
      matchPackageNames: ["buf.build/gen/go/northpolesec/protos/protocolbuffers/go"],
      automerge: true,
    },
    {
      matchManagers: ["npm"],
      matchPackageNames: ["docusaurus-plugin-openapi-docs", "docusaurus-theme-openapi-docs"],
      matchFileNames: ["docs/package.json"],
      groupName: "Docusaurus OpenAPI",
      groupSlug: "docusaurus-openapi",
    },
  ],
}
