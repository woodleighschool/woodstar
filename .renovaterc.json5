{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["local>woodleighschool/renovate-config"],
  postUpdateOptions: ["gomodTidy", "gomodUpdateImportPaths", "pnpmDedupe"],
  packageRules: [
    {
      description: "Docusaurus OpenAPI Group",
      matchManagers: ["npm"],
      matchPackageNames: ["docusaurus-plugin-openapi-docs", "docusaurus-theme-openapi-docs"],
      matchFileNames: ["docs/package.json"],
      groupName: "Docusaurus OpenAPI",
      groupSlug: "docusaurus-openapi",
    },
    {
      description: "Stemma Releases",
      matchPackageNames: ["woodleighschool/stemma", "github.com/woodleighschool/stemma"],
      minimumReleaseAge: null,
    },
  ],
}
